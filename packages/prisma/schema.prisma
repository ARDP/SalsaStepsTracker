generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Step {
  id          String   @id @default(cuid())
  title       String
  description String?
  difficulty  Difficulty
  videoUrl    String?
  createdAt   DateTime @default(now())
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}